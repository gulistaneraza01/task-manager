# ============================================================================
# PRIMARY CONFIGURATION
# ============================================================================

# PROD: "production" | DEV: "local"
TASK_MANAGER_PRIMARY.ENV="local"

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

TASK_MANAGER_SERVER.PORT="8080"
TASK_MANAGER_SERVER.READ_TIMEOUT="30"
TASK_MANAGER_SERVER.WRITE_TIMEOUT="30"
TASK_MANAGER_SERVER.IDLE_TIMEOUT="60"
# Comma-separated list, e.g. "https://app.example.com,https://admin.example.com"
TASK_MANAGER_SERVER.CORS_ALLOWED_ORIGINS="http://localhost:3000"

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

TASK_MANAGER_DATABASE.HOST="localhost"
TASK_MANAGER_DATABASE.PORT="5432"
TASK_MANAGER_DATABASE.USER="postgres"
TASK_MANAGER_DATABASE.PASSWORD="postgres"
TASK_MANAGER_DATABASE.NAME="task-manager"
TASK_MANAGER_DATABASE.SSL_MODE="disable"
TASK_MANAGER_DATABASE.MAX_OPEN_CONNS="15"
TASK_MANAGER_DATABASE.MAX_IDLE_CONNS="10"
TASK_MANAGER_DATABASE.CONN_MAX_LIFETIME="300"
TASK_MANAGER_DATABASE.CONN_MAX_IDLE_TIME="300"

# ============================================================================
# AUTH CONFIGURATION
# ============================================================================

TASK_MANAGER_AUTH.SECRET_KEY="secret"

# ============================================================================
# INTEGRATION CONFIGURATION
# ============================================================================

TASK_MANAGER_INTEGRATION.RESEND_API_KEY="resend_key"

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# Background jobs
TASK_MANAGER_REDIS_JOB.ADDRESS="redis://localhost:6379"

# Cache
TASK_MANAGER_REDIS_CACHE.ADDRESS="redis://localhost:6380"

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================

# Service Identity
TASK_MANAGER_OBSERVABILITY.SERVICE_NAME="task-manager"
# Ignored: overridden by PRIMARY.ENV at startup
TASK_MANAGER_OBSERVABILITY.ENVIRONMENT="development"

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Basic Logging Settings
# PROD: "info" | DEV: "debug"
TASK_MANAGER_OBSERVABILITY.LOGGING.LEVEL="debug"
# PROD: "json" | DEV: "console"
TASK_MANAGER_OBSERVABILITY.LOGGING.FORMAT="console"
TASK_MANAGER_OBSERVABILITY.LOGGING.SLOW_QUERY_THRESHOLD="100ms"

# ============================================================================
# NEW RELIC CONFIGURATION
# ============================================================================

# New Relic APM
TASK_MANAGER_OBSERVABILITY.NEW_RELIC.LICENSE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TASK_MANAGER_OBSERVABILITY.NEW_RELIC.APP_LOG_FORWARDING_ENABLED="true"
TASK_MANAGER_OBSERVABILITY.NEW_RELIC.DISTRIBUTED_TRACING_ENABLED="true"
TASK_MANAGER_OBSERVABILITY.NEW_RELIC.DEBUG_LOGGING="false"

# ============================================================================
# HEALTH CHECKS CONFIGURATION
# ============================================================================

# Health Check Settings
TASK_MANAGER_OBSERVABILITY.HEALTH_CHECKS.ENABLED="true"
TASK_MANAGER_OBSERVABILITY.HEALTH_CHECKS.INTERVAL="30s"
TASK_MANAGER_OBSERVABILITY.HEALTH_CHECKS.TIMEOUT="5s"
TASK_MANAGER_OBSERVABILITY.HEALTH_CHECKS.CHECKS="database,redis_job,redis_cache"

# ============================================================================
# AWS CONFIGURATION
# ============================================================================

# Credentials
TASK_MANAGER_AWS.REGION="us-east-1"
TASK_MANAGER_AWS.ACCESS_KEY_ID="your_aws_access_key_id"
TASK_MANAGER_AWS.SECRET_ACCESS_KEY="your_aws_secret_access_key"

# S3 Storage
TASK_MANAGER_AWS.S3.ENDPOINT_URL="https://s3.us-east-1.amazonaws.com"
TASK_MANAGER_AWS.S3.BUCKET="your-bucket-name"
